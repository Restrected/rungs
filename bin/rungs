#!/usr/bin/env python3
"""Launcher for rungs. Runs from a git clone with no installation: it puts
the sibling src/ on sys.path and hands over to rungs.cli.main."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SRC = os.path.join(os.path.dirname(HERE), "src")
if os.path.isdir(SRC) and SRC not in sys.path:
    sys.path.insert(0, SRC)

if sys.version_info < (3, 9):
    sys.stderr.write("rungs needs Python 3.9 or newer\n")
    sys.exit(1)

from rungs.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
